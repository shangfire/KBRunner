;
; KMDriver.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
CatalogFile=KMDriver.cat
DriverVer=
PnpLockDown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
KMDriver.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%KMDriver.DeviceDesc%=KMDriver_Device, Root\KMDriver

[KMDriver_Device.NT]
CopyFiles=File_Copy

[File_Copy]
KMDriver.sys

[KMDriver_Device.NT.HW]
AddReg=KMDriver_AddReg

[KMDriver_AddReg]
; VHF 为源设备创建虚拟 HID 子设备。
HKR,,LowerFilters,0x00010000,"vhf"
; By default, USBDevice class uses iProduct descriptor to name the device
; Uncomment for this device to use %KMDriver.DeviceDesc%
;HKR,,FriendlyName,,%KMDriver.DeviceDesc%

;-------------- Service installation
[KMDriver_Device.NT.Services]
AddService = KMDriver,%SPSVCINST_ASSOCSERVICE%, KMDriver_Service_Inst

; -------------- KMDriver driver install sections
[KMDriver_Service_Inst]
DisplayName    = %KMDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\KMDriver.sys

[KMDriver_Device.NT.Wdf]
KmdfService =  KMDriver, KMDriver_wdfsect

[KMDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="KMEmulator"
DiskName = "KMDriver Installation Disk"
KMDriver.DeviceDesc = "KMDriver Device"
KMDriver.SVCDESC = "KMDriver Service"